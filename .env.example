# Where the pipeline reads/writes its dataset: 'local' (data/output/, safe for dev) or 'r2' (production).
# CI and the cron scripts in bin/ always force 'r2' regardless of this value.
DATA_STORE=local

# Tiltify API credentials
# Create an application at: tiltify.com → account settings → Applications
TILTIFY_CLIENT_ID=
TILTIFY_CLIENT_SECRET=

# Cloudflare R2
# Account ID: Cloudflare dashboard → right sidebar
# Access key: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
# Bucket name: the shared "cdawgva" bucket, holds every event under a per-event key prefix
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cdawgva
